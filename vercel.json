{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://sendera-34791.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/catalogo-meta.csv",
      "destination": "/api/catalogo"
    },
    {
      "source": "/seguimiento",
      "destination": "/seguimiento.html"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
