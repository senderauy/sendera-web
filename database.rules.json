{
  "rules": {
    "admins": {
      "$email": {
        ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $email"
      }
    },

    "productos": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "stock": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "colecciones": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "lookbook": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "resenas": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },

    "resenas_pendientes": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      "$id": {
        ".write": "(auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['nombre', 'texto']) && newData.child('nombre').isString() && newData.child('nombre').val().length <= 40 && newData.child('texto').isString() && newData.child('texto').val().length <= 300 && (!newData.child('ciudad').exists() || (newData.child('ciudad').isString() && newData.child('ciudad').val().length <= 40)) && (!newData.child('estrellas').exists() || (newData.child('estrellas').isNumber() && newData.child('estrellas').val() >= 1 && newData.child('estrellas').val() <= 5))"
      }
    },
    "codigos_descuento": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      "$codigo": {
        ".read": true
      }
    },
    "pedidos": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      "$id": {
        ".write": "(auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['fecha', 'productos', 'total', 'estado']) && newData.child('total').isNumber() && (!newData.child('cliente').exists() || (newData.child('cliente').isString() && newData.child('cliente').val().length <= 80)) && (!newData.child('celular').exists() || (newData.child('celular').isString() && newData.child('celular').val().length <= 30)) && (!newData.child('envio').exists() || (newData.child('envio').isString() && newData.child('envio').val().length <= 200)) && (!newData.child('comprobante').exists() || (newData.child('comprobante').isString() && newData.child('comprobante').val().length <= 3000000))"
      }
    },
    "carritos_abandonados": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      "$id": {
        ".write": "(auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true) || !data.exists() || !newData.exists()"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "pedidos": {
          ".indexOn": ["fecha"]
        }
      }
    },

    "leads_whatsapp": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "ventas_manual": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "gastos": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    },
    "compras": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email_verified === true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true"
    }
  }
}
